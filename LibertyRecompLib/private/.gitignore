# Ignore everything by default
*

# Track this file
!.gitignore

# Track button prompts directory (custom project assets)
!button_prompts/
!button_prompts/*/
!button_prompts/**/*.xtd
!button_prompts/**/*.dds
!button_prompts/**/*.json

# Never track copyrighted game files or build intermediates
*.xex
*.rpf
*.iso
*.xcp
.DS_Store

# [web port] the pause menu Controls pictures: frontend_360.xtd, a copy of the
# game's own menu textures, stays local; the pictures alone (our drawings:
# controller.bin, the keyboard's controls_*.bin, and controller-place.txt) are
# tracked, and put into the player's own file (rpf_button_prompts.cpp).
button_prompts/*/frontend_360.xtd
!button_prompts/controller-place.txt
!button_prompts/**/controller.bin
!button_prompts/keyboard/controls_*.bin
